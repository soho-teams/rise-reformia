# Salin ke `.env` lalu sesuaikan. Jangan pernah commit `.env`.

# Database PostgreSQL untuk dev. Dengan `docker compose up`, host-nya `postgres`.
DATABASE_URL=postgres://rise:rise@localhost:5432/rise

# Rahasia untuk menandatangani token login Payload. Buat dengan: openssl rand -hex 32
PAYLOAD_SECRET=ganti-dengan-string-acak-panjang

# Opsional: database khusus tes (Seam 1 dan Seam 2). Isinya DIHAPUS setiap kali tes jalan.
# TEST_DATABASE_URL=postgres://rise:rise@localhost:5432/rise_test

# Notifikasi Lead lewat SMTP (akun email cPanel). Bila kosong, Lead tetap tersimpan
# dengan status notifikasi "gagal" dan bisa dilihat Admin di panel.
# SMTP_HOST=mail.rise-reformia.id
# SMTP_PORT=465
# SMTP_USER=noreply@rise-reformia.id
# SMTP_PASS=
# SMTP_FROM=RISE <noreply@rise-reformia.id>
# LEAD_NOTIFY_TO=business@rise-reformia.id
